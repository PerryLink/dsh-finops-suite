    "access": "public"
  },
  "dependencies": {
    "dsh-einvoice": "0.2.0-alpha.11",
    "dsh-bankrec": "0.1.0-alpha.16",
    "dsh-ap-three-way": "0.1.0-alpha.11",
    "dsh-travel-recon": "0.1.0-alpha.13"
  },
  "icon": "icon.svg"
}
